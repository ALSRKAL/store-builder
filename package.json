{
  "name": "store-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p workers/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:release": "node --test scripts/release/*.test.mjs",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "lint:gate": "node scripts/lint-gate.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "db:check": "node scripts/db/migrations.mjs check",
    "db:test": "node scripts/db/migrations.mjs local-test",
    "build:ci": "node scripts/build-ci.mjs",
    "check:css": "node scripts/check-css.mjs",
    "build:worker": "wrangler deploy --config workers/wrangler.toml --dry-run --outdir artifacts/worker",
    "verify": "npm run typecheck && npm run typecheck:worker && npm run test && npm run lint && npm run build",
    "verify:ci": "npm run typecheck && npm run typecheck:worker && npm run typecheck:tooling && npm run test:coverage && npm run test:release && npm run lint:gate && npm run security:secrets && npm run security:audit && npm run db:check && npm run db:test && npm run build:ci && npm run check:css && npm run build:worker && npm run test:e2e && npm run test:e2e:production",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-01-01",
    "release:preflight": "node scripts/release/cli.mjs preflight",
    "release:deploy": "node scripts/release/cli.mjs deploy",
    "release:rollback": "node scripts/release/cli.mjs rollback",
    "release:monitor": "node scripts/release/cli.mjs monitor",
    "pages:deploy": "node scripts/release/cli.mjs deploy",
    "pages:login": "wrangler login"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.2.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "miniflare": { "undici": "7.30.2", "sharp": "0.35.5" }
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "acorn": "8.15.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.23",
    "depcheck": "^1.4.7",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "leaflet": "1.9.4",
    "miniflare": "4.20260730.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.2.4",
    "vitest": "^4.1.12",
    "wrangler": "4.166.0",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  }
}
