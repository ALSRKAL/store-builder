{
  "name": "store-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers API for Store App",
  "main": "api/index.ts",
  "private": true,
  "engines": { "node": "24.22.3" },
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/wrangler/bin/wrangler.js dev --config wrangler.toml",
    "deploy": "node ../scripts/release/cli.mjs deploy",
    "db:check": "node ../scripts/db/migrations.mjs check",
    "db:test": "node ../scripts/db/migrations.mjs local-test",
    "tail": "node ../node_modules/wrangler/bin/wrangler.js tail --config wrangler.toml"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {}
}
